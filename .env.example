# Supabase project settings
# Find these in Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only. Never expose this key in frontend code or commit it.
# Use this only for trusted backend jobs that need elevated access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only needed for direct PostgreSQL connections or migrations.
# Keep the password URL-encoded if it contains special characters.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Existing Supabase Storage bucket used for uploaded document images.
SUPABASE_STORAGE_BUCKET=

# OCR configuration
TESSERACT_CMD=
